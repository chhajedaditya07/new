<Application x:Class="StoreManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Touch-friendly hit targets: at least 40px high, base text 14px. -->
            <x:Double x:Key="ControlContentThemeFontSize">14</x:Double>
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinHeight" Value="40" />
            </Style>
            <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="MinHeight" Value="40" />
            </Style>
            <Style TargetType="DropDownButton" BasedOn="{StaticResource DefaultDropDownButtonStyle}">
                <Setter Property="MinHeight" Value="40" />
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="MinHeight" Value="40" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="MinHeight" Value="40" />
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
                <Setter Property="MinHeight" Value="40" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
