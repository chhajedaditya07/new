<Window x:Class="StoreManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <NavigationView x:Name="Nav"
                        PaneDisplayMode="Left"
                        OpenPaneLength="230"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Nav_Dashboard" Tag="dashboard"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Tasks" Tag="tasks"><NavigationViewItem.Icon><FontIcon Glyph="&#xE73A;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_FollowUps" Tag="followups"><NavigationViewItem.Icon><FontIcon Glyph="&#xE717;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Contacts" Tag="contacts"><NavigationViewItem.Icon><FontIcon Glyph="&#xE716;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Payments" Tag="payments"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8C7;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_FallPico" Tag="fallpico"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D2;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Reports" Tag="reports"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="Nav_Settings" Tag="settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" />

                <InfoBar x:Name="Toast"
                         VerticalAlignment="Bottom" HorizontalAlignment="Center"
                         Margin="24" MaxWidth="600"
                         IsClosable="True" IsOpen="False">
                    <InfoBar.ActionButton>
                        <Button x:Name="ToastAction" Click="ToastAction_Click" Visibility="Collapsed" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
