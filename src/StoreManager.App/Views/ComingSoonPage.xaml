<Page x:Class="StoreManager.App.Views.ComingSoonPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="520" Padding="24">
        <FontIcon Glyph="&#xE7C9;" FontSize="48" HorizontalAlignment="Center" Opacity="0.6" />
        <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
        <TextBlock x:Name="BodyText" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.8" />
    </StackPanel>
</Page>
