<Page x:Class="StoreManager.App.Views.ContactsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:StoreManager.App"
      xmlns:vm="using:StoreManager.ViewModels.Contacts"
      NavigationCacheMode="Required"
      Loaded="Page_Loaded">

    <Grid Padding="24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Uid="Contacts_Title" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" VerticalAlignment="Bottom" Opacity="0.75" />
            </StackPanel>
            <Button Grid.Column="1" x:Uid="Contacts_Import" Click="Import_Click" />
            <Button Grid.Column="2" x:Uid="Contacts_Export" Command="{x:Bind ViewModel.ExportCommand}" />
            <Button Grid.Column="3" x:Uid="Contacts_ManageTags" Click="ManageTags_Click" />
            <Button Grid.Column="4" x:Uid="Contacts_New" Style="{StaticResource AccentButtonStyle}" MinHeight="40"
                    Command="{x:Bind ViewModel.NewContactCommand}" />
        </Grid>

        <!-- ===== Search and filters ===== -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" x:Uid="Contacts_Search" Width="300"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.TypeFilters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TypeFilterOption">
                        <ToggleButton IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Content="{x:Bind Label}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DropDownButton Grid.Column="2" Content="{x:Bind ViewModel.TagFilterSummary, Mode=OneWay}">
                <DropDownButton.Flyout>
                    <Flyout>
                        <StackPanel Width="300" Spacing="8">
                            <ToggleSwitch x:Uid="Filter_MatchMode" IsOn="{x:Bind ViewModel.TagMatchAll, Mode=TwoWay}" />
                            <ListView ItemsSource="{x:Bind ViewModel.TagFilters}" SelectionMode="None" MaxHeight="320">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TagFilterOption">
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Content="{x:Bind Display}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <ComboBox Grid.Column="3" ItemsSource="{x:Bind ViewModel.SortOptions}" DisplayMemberPath="Label"
                      SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}" MinWidth="170" />

            <Button Grid.Column="4" x:Uid="Filter_Clear" HorizontalAlignment="Left"
                    Command="{x:Bind ViewModel.ClearFiltersCommand}"
                    Visibility="{x:Bind local:Fx.Vis(ViewModel.HasActiveFilters), Mode=OneWay}" />
        </Grid>

        <!-- ===== Bulk actions (when several rows are selected) ===== -->
        <Border Grid.Row="2" Padding="12,6" CornerRadius="6"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                Visibility="{x:Bind local:Fx.Vis(ViewModel.HasMultiSelection), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" />
                <DropDownButton x:Uid="Bulk_AddTag"><DropDownButton.Flyout><MenuFlyout x:Name="AddTagFlyout" Opening="AddTagFlyout_Opening" /></DropDownButton.Flyout></DropDownButton>
                <DropDownButton x:Uid="Bulk_RemoveTag"><DropDownButton.Flyout><MenuFlyout x:Name="RemoveTagFlyout" Opening="RemoveTagFlyout_Opening" /></DropDownButton.Flyout></DropDownButton>
                <Button x:Uid="Bulk_Delete" Command="{x:Bind ViewModel.DeleteSelectedCommand}" />
                <Button x:Uid="Bulk_Clear" Click="ClearSelection_Click" />
            </StackPanel>
        </Border>

        <!-- ===== List + side panel ===== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- List -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12" Padding="16,6,16,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="100" />
                        <ColumnDefinition Width="120" /><ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Col_Name" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" />
                    <TextBlock Grid.Column="1" x:Uid="Col_Mobile" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" />
                    <TextBlock Grid.Column="2" x:Uid="Col_Type" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" />
                    <TextBlock Grid.Column="3" x:Uid="Col_City" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" />
                    <TextBlock Grid.Column="4" x:Uid="Col_Tags" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" />
                </Grid>

                <ListView x:Name="List" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items}"
                          SelectionMode="Extended" SelectionChanged="List_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ContactRowViewModel">
                            <Grid ColumnSpacing="12" MinHeight="52">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" /><ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind MobileDisplay}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind TypeLabel}" VerticalAlignment="Center" Opacity="0.85" />
                                <TextBlock Grid.Column="3" Text="{x:Bind City}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <ItemsControl Grid.Column="4" ItemsSource="{x:Bind Tags}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TagChipViewModel">
                                            <Border CornerRadius="10" Padding="8,2" Background="{x:Bind local:Fx.Brush(ColorHex)}">
                                                <TextBlock Text="{x:Bind Name}" FontSize="12" Foreground="{x:Bind local:Fx.Contrast(ColorHex)}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Loading skeleton (never a blank screen) -->
                <StackPanel Grid.Row="1" Spacing="8" Padding="16,8" IsHitTestVisible="False"
                            Visibility="{x:Bind local:Fx.Vis(ViewModel.ShowSkeleton), Mode=OneWay}">
                    <Border Height="44" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                    <Border Height="44" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                    <Border Height="44" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                    <Border Height="44" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                    <Border Height="44" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                    <Border Height="44" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Empty: no contacts at all -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                            Visibility="{x:Bind local:Fx.Vis(ViewModel.ShowEmptyState), Mode=OneWay}">
                    <FontIcon Glyph="&#xE716;" FontSize="48" Opacity="0.6" />
                    <TextBlock x:Uid="Empty_Title" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Uid="Empty_Body" TextAlignment="Center" Opacity="0.8" MaxWidth="360" TextWrapping="Wrap" />
                    <Button x:Uid="Empty_Add" Style="{StaticResource AccentButtonStyle}" MinHeight="40" HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.NewContactCommand}" />
                    <HyperlinkButton x:Uid="Empty_Demo" HorizontalAlignment="Center" Command="{x:Bind ViewModel.LoadDemoCommand}" />
                </StackPanel>

                <!-- Empty: filters match nothing -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                            Visibility="{x:Bind local:Fx.Vis(ViewModel.ShowNoMatches), Mode=OneWay}">
                    <FontIcon Glyph="&#xE721;" FontSize="48" Opacity="0.6" />
                    <TextBlock x:Uid="NoMatch_Title" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <Button x:Uid="Filter_Clear" HorizontalAlignment="Center" Command="{x:Bind ViewModel.ClearFiltersCommand}" />
                </StackPanel>
            </Grid>

            <!-- Side panel: profile and add/edit form -->
            <Border Grid.Column="1" Width="440" Margin="16,0,0,0" CornerRadius="8" Padding="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{x:Bind local:Fx.Vis(ViewModel.Panel.IsOpen), Mode=OneWay}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Padding="20,14,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.Panel.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Uid="Panel_Close" Command="{x:Bind ViewModel.Panel.CloseCommand}" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </Grid>

                    <!-- ===== PROFILE ===== -->
                    <ScrollViewer Grid.Row="1" Visibility="{x:Bind local:Fx.Vis(ViewModel.Panel.IsViewing), Mode=OneWay}">
                        <StackPanel Padding="20,0,20,16" Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border CornerRadius="10" Padding="10,3" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.Panel.TypeText, Mode=OneWay}" FontSize="12" />
                                </Border>
                                <Border CornerRadius="10" Padding="10,3" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C7;" FontSize="12" />
                                        <TextBlock FontSize="12">
                                            <Run Text="{x:Bind ViewModel.Panel.BalanceCaption}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.Panel.BalanceText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Panel.ProfileTags, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="110" MinRowSpacing="6" MinColumnSpacing="6" ItemsStretch="None" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TagChipViewModel">
                                        <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" Background="{x:Bind local:Fx.Brush(ColorHex)}">
                                            <TextBlock Text="{x:Bind Name}" FontSize="12" Foreground="{x:Bind local:Fx.Contrast(ColorHex)}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- One-click actions -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind ViewModel.Panel.CopyNumberCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE717;" FontSize="14" /><TextBlock x:Uid="Panel_Call" /></StackPanel></Button>
                                <Button Command="{x:Bind ViewModel.Panel.OpenWhatsAppCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8BD;" FontSize="14" /><TextBlock x:Uid="Panel_WhatsApp" /></StackPanel></Button>
                                <Button Command="{x:Bind ViewModel.Panel.CopyAddressCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C8;" FontSize="14" /><TextBlock x:Uid="Panel_CopyAddress" /></StackPanel></Button>
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <StackPanel><TextBlock x:Uid="Field_Mobile" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" /><TextBlock Text="{x:Bind ViewModel.Panel.MobileDisplay, Mode=OneWay}" IsTextSelectionEnabled="True" /></StackPanel>
                                <StackPanel><TextBlock x:Uid="Field_WhatsApp" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" /><TextBlock Text="{x:Bind ViewModel.Panel.WhatsAppDisplay, Mode=OneWay}" IsTextSelectionEnabled="True" /></StackPanel>
                                <StackPanel Visibility="{x:Bind local:Fx.Vis(ViewModel.Panel.HasAltPhone), Mode=OneWay}"><TextBlock x:Uid="Field_AltPhone" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" /><TextBlock Text="{x:Bind ViewModel.Panel.AltPhoneDisplay, Mode=OneWay}" IsTextSelectionEnabled="True" /></StackPanel>
                                <StackPanel Visibility="{x:Bind local:Fx.Vis(ViewModel.Panel.HasCity), Mode=OneWay}"><TextBlock x:Uid="Field_City" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" /><TextBlock Text="{x:Bind ViewModel.Panel.City, Mode=OneWay}" IsTextSelectionEnabled="True" /></StackPanel>
                                <StackPanel Visibility="{x:Bind local:Fx.Vis(ViewModel.Panel.HasAddress), Mode=OneWay}"><TextBlock x:Uid="Field_Address" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" /><TextBlock Text="{x:Bind ViewModel.Panel.Address, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></StackPanel>
                                <StackPanel Visibility="{x:Bind local:Fx.Vis(ViewModel.Panel.HasGstin), Mode=OneWay}"><TextBlock x:Uid="Field_Gstin" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" /><TextBlock Text="{x:Bind ViewModel.Panel.Gstin, Mode=OneWay}" IsTextSelectionEnabled="True" /></StackPanel>
                                <StackPanel Visibility="{x:Bind local:Fx.Vis(ViewModel.Panel.HasBirthday), Mode=OneWay}"><TextBlock x:Uid="Field_Birthday" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" /><TextBlock Text="{x:Bind ViewModel.Panel.BirthdayText, Mode=OneWay}" /></StackPanel>
                                <StackPanel Visibility="{x:Bind local:Fx.Vis(ViewModel.Panel.HasAnniversary), Mode=OneWay}"><TextBlock x:Uid="Field_Anniversary" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" /><TextBlock Text="{x:Bind ViewModel.Panel.AnniversaryText, Mode=OneWay}" /></StackPanel>
                                <StackPanel Visibility="{x:Bind local:Fx.Vis(ViewModel.Panel.HasNotes), Mode=OneWay}"><TextBlock x:Uid="Field_Notes" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" /><TextBlock Text="{x:Bind ViewModel.Panel.Notes, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></StackPanel>
                            </StackPanel>

                            <Border Padding="14" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="Panel_TimelineTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="Panel_TimelineNote" TextWrapping="Wrap" Opacity="0.8" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== EDIT FORM ===== -->
                    <ScrollViewer Grid.Row="1" Visibility="{x:Bind local:Fx.Vis(ViewModel.Panel.IsEditing), Mode=OneWay}">
                        <StackPanel Padding="20,0,20,16" Spacing="12">
                            <StackPanel.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter" Invoked="SaveAccelerator_Invoked" />
                                <KeyboardAccelerator Key="Escape" Invoked="CancelAccelerator_Invoked" />
                            </StackPanel.KeyboardAccelerators>

                            <ComboBox x:Uid="Field_Type" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.Panel.TypeOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{x:Bind ViewModel.Panel.SelectedType, Mode=TwoWay}" />

                            <StackPanel Spacing="4">
                                <TextBox x:Uid="Field_Name" Text="{x:Bind ViewModel.Panel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind local:Fx.Vis(ViewModel.Panel.HasNameError), Mode=OneWay}">
                                    <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Panel.NameError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBox x:Uid="Field_MobileInput" InputScope="TelephoneNumber" LostFocus="Phone_LostFocus"
                                         Text="{x:Bind ViewModel.Panel.Mobile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind local:Fx.Vis(ViewModel.Panel.HasMobileError), Mode=OneWay}">
                                    <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Panel.MobileError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </StackPanel>
                                <!-- Duplicate warning: icon + text, with a way to open the existing contact -->
                                <InfoBar Severity="Warning" IsClosable="False" IsOpen="{x:Bind ViewModel.Panel.HasDuplicateWarning, Mode=OneWay}"
                                         Message="{x:Bind ViewModel.Panel.DuplicateWarning, Mode=OneWay}">
                                    <InfoBar.ActionButton>
                                        <Button x:Uid="Panel_OpenExisting" Command="{x:Bind ViewModel.Panel.OpenDuplicateCommand}" />
                                    </InfoBar.ActionButton>
                                </InfoBar>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBox x:Uid="Field_WhatsAppInput" InputScope="TelephoneNumber" LostFocus="Phone_LostFocus"
                                         Text="{x:Bind ViewModel.Panel.WhatsApp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind local:Fx.Vis(ViewModel.Panel.HasWhatsAppError), Mode=OneWay}">
                                    <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Panel.WhatsAppError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBox x:Uid="Field_AltPhoneInput" InputScope="TelephoneNumber" LostFocus="Phone_LostFocus"
                                         Text="{x:Bind ViewModel.Panel.AltPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind local:Fx.Vis(ViewModel.Panel.HasAltPhoneError), Mode=OneWay}">
                                    <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Panel.AltPhoneError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBox x:Uid="Field_CityInput" Text="{x:Bind ViewModel.Panel.City, Mode=TwoWay}" />
                            <TextBox x:Uid="Field_AddressInput" TextWrapping="Wrap" MinHeight="64" Text="{x:Bind ViewModel.Panel.Address, Mode=TwoWay}" />

                            <StackPanel Spacing="4">
                                <TextBox x:Uid="Field_GstinInput" CharacterCasing="Upper" MaxLength="15" Text="{x:Bind ViewModel.Panel.Gstin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind local:Fx.Vis(ViewModel.Panel.HasGstinError), Mode=OneWay}">
                                    <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Panel.GstinError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <CalendarDatePicker x:Uid="Field_Birthday_Input" DateFormat="{}{day.integer(2)}-{month.integer(2)}-{year.full}"
                                                    Date="{x:Bind ViewModel.Panel.Birthday, Mode=TwoWay}" MinHeight="40" />
                                <CalendarDatePicker x:Uid="Field_Anniversary_Input" DateFormat="{}{day.integer(2)}-{month.integer(2)}-{year.full}"
                                                    Date="{x:Bind ViewModel.Panel.Anniversary, Mode=TwoWay}" MinHeight="40" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Field_Tags" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Panel.TagChoices, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="130" MinRowSpacing="6" MinColumnSpacing="6" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TagChoice">
                                            <ToggleButton IsChecked="{x:Bind IsSelected, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Ellipse Width="12" Height="12" Fill="{x:Bind local:Fx.Brush(ColorHex)}" />
                                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Visibility="{x:Bind local:Fx.Vis(IsSelected), Mode=OneWay}" />
                                                </StackPanel>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <TextBlock x:Uid="Field_TagsHint" Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>

                            <TextBox x:Uid="Field_NotesInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" Text="{x:Bind ViewModel.Panel.Notes, Mode=TwoWay}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Footer buttons ===== -->
                    <Grid Grid.Row="2" Padding="20,12" ColumnSpacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind local:Fx.Vis(ViewModel.Panel.IsViewing), Mode=OneWay}">
                            <Button x:Uid="Panel_Edit" Style="{StaticResource AccentButtonStyle}" MinHeight="40" Command="{x:Bind ViewModel.Panel.EditCommand}" />
                            <Button x:Uid="Panel_Delete" Command="{x:Bind ViewModel.Panel.RequestDeleteCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind local:Fx.Vis(ViewModel.Panel.IsEditing), Mode=OneWay}">
                            <Button x:Uid="Panel_Save" Style="{StaticResource AccentButtonStyle}" MinHeight="40" Command="{x:Bind ViewModel.Panel.SaveCommand}" />
                            <Button x:Uid="Panel_Cancel" Command="{x:Bind ViewModel.Panel.CancelCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
