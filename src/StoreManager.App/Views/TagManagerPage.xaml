<Page x:Class="StoreManager.App.Views.TagManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:StoreManager.App"
      xmlns:vm="using:StoreManager.ViewModels.Tags">
    <Grid Padding="32,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Click="Back_Click" x:Uid="Tags_Back"><FontIcon Glyph="&#xE72B;" /></Button>
            <TextBlock x:Uid="Tags_Title" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Create new tag -->
        <StackPanel Grid.Row="1" Spacing="8" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock x:Uid="Tags_NewHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBox x:Uid="Tags_NewName" Width="260" Text="{x:Bind ViewModel.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="NewName_KeyDown" />
                <GridView x:Name="NewColorGrid" ItemsSource="{x:Bind vm:TagManagerViewModel.Swatches}" SelectionMode="Single"
                          SelectionChanged="NewColor_SelectionChanged" Loaded="NewColorGrid_Loaded" MaxWidth="460">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:Swatch">
                            <Border Width="28" Height="28" CornerRadius="14" Background="{x:Bind local:Fx.Brush(Hex)}" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <Button x:Uid="Tags_Add" Style="{StaticResource AccentButtonStyle}" MinHeight="40" Command="{x:Bind ViewModel.CreateCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Inline error (icon + text, never colour alone) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind local:Fx.Vis(ViewModel.HasError), Mode=OneWay}">
            <FontIcon Glyph="&#xE783;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="16" />
            <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </StackPanel>

        <!-- Existing tags -->
        <Grid Grid.Row="3">
            <ListView ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None" MaxWidth="900" HorizontalAlignment="Left">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TagRowViewModel">
                        <Grid ColumnSpacing="12" MinHeight="52" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <DropDownButton Grid.Column="0" IsEnabled="{x:Bind CanEdit}" Padding="8">
                                <Border Width="20" Height="20" CornerRadius="10" Background="{x:Bind local:Fx.Brush(ColorHex), Mode=OneWay}" />
                                <DropDownButton.Flyout>
                                    <Flyout>
                                        <GridView ItemsSource="{x:Bind vm:TagManagerViewModel.Swatches}" IsItemClickEnabled="True"
                                                  Tag="{x:Bind}" ItemClick="RowColor_ItemClick" MaxWidth="260">
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="vm:Swatch">
                                                    <Border Width="28" Height="28" CornerRadius="14" Background="{x:Bind local:Fx.Brush(Hex)}" />
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <TextBox Grid.Column="1" Text="{x:Bind Name, Mode=TwoWay}" IsEnabled="{x:Bind CanEdit}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ContactCount}" VerticalAlignment="Center" Opacity="0.8" />
                            <Button Grid.Column="3" x:Uid="Tags_Save" Tag="{x:Bind}" Click="RowSave_Click"
                                    Visibility="{x:Bind local:Fx.Vis(IsDirty), Mode=OneWay}" />
                            <Button Grid.Column="4" x:Uid="Tags_Merge" Tag="{x:Bind}" Click="RowMerge_Click"
                                    IsEnabled="{x:Bind CanEdit}" />
                            <Button Grid.Column="5" x:Uid="Tags_Delete" Tag="{x:Bind}" Click="RowDelete_Click"
                                    IsEnabled="{x:Bind CanEdit}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind local:Fx.Vis(ViewModel.IsEmpty), Mode=OneWay}">
                <FontIcon Glyph="&#xE8EC;" FontSize="40" Opacity="0.6" />
                <TextBlock x:Uid="Tags_Empty" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
